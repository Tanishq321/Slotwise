                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@slotwise.dev\",\n  \"password\": \"Slotwise@2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
