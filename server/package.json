{
  "name": "@slotwise/server",
  "version": "0.1.0",
  "description": "Slotwise REST API: Express + PostgreSQL + MongoDB + Redis (BullMQ)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "worker": "node src/worker.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@slotwise/engine": "*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.6",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2"
  }
}
